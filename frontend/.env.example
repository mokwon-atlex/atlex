# ── 필수 ──────────────────────────────────────────────────────────────────
# 백엔드 오리진. next.config.mjs rewrites 프록시의 목적지로 사용된다.
# /api/v1/* 요청이 여기로 포워딩되므로 경로(/api/v1) 없이 오리진만 입력.
# 백엔드 HTTPS 전환 시 이 값만 https://... 로 교체.
BACKEND_ORIGIN=http://localhost:8080

# 서버(RSC/route handler)가 백엔드를 직접 호출할 때 쓰는 주소 (경로 포함).
BASE_API_URL=http://localhost:8080/api/v1

# ── 선택 ──────────────────────────────────────────────────────────────────
# 클라이언트(브라우저)가 프록시를 거치지 않고 백엔드를 직접 호출하도록 전환할 때만 설정.
# 반드시 백엔드 HTTPS + CORS 가 준비된 뒤에만 주석 해제할 것.
# NEXT_PUBLIC_BASE_API_URL=https://api.example.com/api/v1
