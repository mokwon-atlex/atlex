# 이 파일을 복사해 .env 로 만들고 실제 값을 채운다 (.env 는 절대 커밋 금지).
#   cp .env.example .env

# RDS 접속 정보
DB_HOST=your-instance.xxxxxxxx.ap-northeast-2.rds.amazonaws.com
DB_NAME=atlex
DB_USERNAME=admin
DB_PASSWORD=change-me-strong-password

# JWT 서명 키 — 생성: openssl rand -base64 48
JWT_SECRET=change-me-random-64-chars-or-more

# GitHub 연동 정보
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/blog_option
GITHUB_TOKEN_ENCRYPTION_KEY=change-me-32-chars-or-more-aes-key

